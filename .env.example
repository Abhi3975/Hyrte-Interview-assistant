# ─────────────────────────────────────────────────────────────
# InterviewAI — environment template. Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# PostgreSQL (primary writer)
DATABASE_URL=postgresql://interviewai:interviewai@localhost:5432/interviewai?schema=public
# Optional read replica for read-heavy queries (analytics, question search)
DATABASE_REPLICA_URL=postgresql://interviewai:interviewai@localhost:5432/interviewai?schema=public

# Redis (cache, queues, rate-limit, sessions)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# AI Providers (all optional — the router degrades gracefully to whatever is set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# Default provider/model used when a request does not pin one
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini

# Speech (voice interview)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Object storage (resumes, recordings)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=interviewai
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Question aggregator sources
HUGGINGFACE_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
GITHUB_TOKEN=

# Code execution engine (DSA sandbox) — e.g. self-hosted Judge0
CODE_EXEC_URL=http://localhost:2358
CODE_EXEC_TOKEN=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Proctoring integration — external proctor app can register a webhook here,
# and InterviewAI signs outgoing events with this shared secret.
PROCTOR_WEBHOOK_SECRET=change-me-proctor-secret

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
